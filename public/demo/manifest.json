{
  "name": "Synthetic pathology CDA and PDF bundle",
  "version": "1.0.0",
  "synthetic": true,
  "description": "A presentation-safe HL7 CDA pathology bundle with a companion PDF, reference FHIR R4 Bundle, policy and three controlled candidate outputs.",
